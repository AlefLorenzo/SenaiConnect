# Configuração local do backend SENAI Connect
# Copie este arquivo para .env e preencha os dados privados no seu computador.

NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
# Origens extras separadas por vírgula, se necessário.
FRONTEND_URLS=

# Supabase Auth (chave publicável/anon, nunca service_role).
SUPABASE_URL=https://djozrelupveraixdvccl.supabase.co
SUPABASE_PUBLISHABLE_KEY=COLE_AQUI_A_PUBLISHABLE_KEY_DO_SUPABASE
# SUPABASE_ANON_KEY=ALTERNATIVA_LEGADA

# Storage permanente de arquivos (somente backend; nunca use no frontend).
# Gere a chave secreta/secret key em Supabase > Project Settings > API Keys.
SUPABASE_SECRET_KEY=COLE_AQUI_A_SECRET_KEY_DO_SUPABASE

# Supabase PostgreSQL: copie a URI em Supabase > Connect.
# Para servidor persistente, selecione o método de conexão compatível com o ambiente.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[HOST]:[PORT]/postgres
# SUPABASE_DB_URL=ALTERNATIVA_LEGADA
DB_SSL=require
DB_POOL_MAX=10

# Timeout das chamadas REST do Supabase Auth (milissegundos).
SUPABASE_AUTH_TIMEOUT_MS=10000

# Opcional: usado apenas pelo script de cópia de dados MySQL legado.
MYSQL_SOURCE_HOST=127.0.0.1
MYSQL_SOURCE_PORT=3306
MYSQL_SOURCE_USER=root
MYSQL_SOURCE_PASSWORD=
MYSQL_SOURCE_DATABASE=redesocial
