# Backend Environment Variables
# Copie para .env e preencha os valores privados no seu computador.

NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
# URLs adicionais separadas por vírgula para produção (ex.: domínio Vercel)
FRONTEND_URLS=

# Supabase Auth
SUPABASE_URL=https://djozrelupveraixdvccl.supabase.co
SUPABASE_PUBLISHABLE_KEY=COLE_AQUI_A_PUBLISHABLE_KEY_DO_SUPABASE

# Supabase PostgreSQL: copie a URI completa em Supabase > Connect.
# Para backend persistente, prefira Session pooler (não Transaction pooler).
# Nunca envie a senha do banco para o GitHub ou para o frontend.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[HOST]:[PORT]/postgres
DB_SSL=require
DB_POOL_MAX=10

# Origem MySQL local (somente para o script de cópia de dados, quando habilitado).
MYSQL_SOURCE_HOST=127.0.0.1
MYSQL_SOURCE_PORT=3306
MYSQL_SOURCE_USER=root
MYSQL_SOURCE_PASSWORD=
MYSQL_SOURCE_DATABASE=redesocial
