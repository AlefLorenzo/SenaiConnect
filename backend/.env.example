# Backend Environment Variables
# Copie este arquivo para .env e preencha com seus valores

# Servidor
NODE_ENV=development
PORT=5000

# Banco de Dados MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=sua_senha_mysql_aqui
DB_NAME=redesocial

# JWT Secrets (GERE CHAVES SEGURAS COM: openssl rand -base64 64)
JWT_SECRET=cole_aqui_sua_chave_gerada_com_openssl_rand_base64_64
JWT_ADMIN_SECRET=cole_aqui_outra_chave_diferente_tambem_segura

# Admin Seed (credenciais iniciais do super admin)
ADMIN_SEED_EMAIL=admin@senai.com
ADMIN_SEED_PASSWORD=senha_forte_do_admin_aqui

# Frontend URL (para CORS)
FRONTEND_URL=http://localhost:5173