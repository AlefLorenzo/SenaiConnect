# Configuração local do frontend Vite.
# Copie este arquivo para .env dentro de frontend/.

# URL base do backend Express (HTTP e Socket.IO).
VITE_API_URL=http://localhost:5000

# Mantenha false para utilizar Auth/API/dados reais.
# true habilita apenas o modo de demonstração/mock.
VITE_USE_MOCK=false
